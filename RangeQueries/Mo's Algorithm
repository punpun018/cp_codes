struct Query {
        int l, r, idx;
    };

    int block;

    bool compare(const Query& a, const Query& b) {
        int blockA = a.l / block;
        int blockB = b.l / block;

        if (blockA != blockB)
            return blockA < blockB;

        return a.r < b.r;
    }

    vector<bool> calc(vector<int>& nums, int k,
                      vector<vector<int>>& queries) {

        int n = nums.size();
        int m = queries.size();

        block = sqrt(n);

        vector<Query> q(m);

        for (int i = 0; i < m; i++)
            q[i] = {queries[i][0], queries[i][1], i};

        sort(q.begin(), q.end(),
             [&](const Query& a, const Query& b) {
                 return compare(a, b);
             });

        vector<bool> ans(m);

        unordered_map<int, int> freq;

        int currL = 0;
        int currR = -1;

        int distinct = 0;
        int oddFreq = 0;

        for (auto& query : q) {
            int L = query.l;
            int R = query.r;

            // Add from right
            while (currR < R) {
                currR++;

                int x = nums[currR];

                if (freq[x] % 2 == 0)
                    oddFreq++;
                else
                    oddFreq--;

                freq[x]++;

                if (freq[x] == 1)
                    distinct++;
            }


            // Add from left
            while (currL > L) {
                currL--;

                int x = nums[currL];

                if (freq[x] % 2 == 0)
                    oddFreq++;
                else
                    oddFreq--;

                freq[x]++;

                if (freq[x] == 1)
                    distinct++;
            }

            // Remove from left
            while (currL < L) {
                int x = nums[currL];

                if (freq[x] % 2 == 1)
                    oddFreq--;
                else
                    oddFreq++;

                freq[x]--;

                if (freq[x] == 0)
                    distinct--;

                currL++;
            }

            // Remove from right
            while (currR > R) {
                int x = nums[currR];

                if (freq[x] % 2 == 1)
                    oddFreq--;
                else
                    oddFreq++;

                freq[x]--;

                if (freq[x] == 0)
                    distinct--;

                currR--;
            }

            ans[query.idx] = (distinct == k && oddFreq == 0);
            cout << distinct <<" "<< oddFreq << endl;
        }

        return ans;
    }
